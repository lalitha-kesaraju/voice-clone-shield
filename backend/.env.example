# Copy to .env and fill in. NEVER commit real secrets.
#   cp .env.example .env

# Postgres connection (pgvector extension required).
# With docker-compose: postgresql+psycopg2://shield:shield@localhost:5432/shield
DATABASE_URL=postgresql+psycopg2://shield:shield@localhost:5432/shield

# REQUIRED. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex-string

# Token lifetime in minutes
ACCESS_TOKEN_MINUTES=1440

# Local directory for uploaded audio (created automatically)
STORAGE_DIR=./storage

# Match decision thresholds (cosine similarity, 0..1)
MATCH_THRESHOLD=0.70
REVIEW_THRESHOLD=0.55

# Max upload size in MB
MAX_UPLOAD_MB=50
